{
    "name": "slotspot-mj-frontend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Frontend de SlotSpot MJ, sistema web de administracion de parqueadero",
    "scripts": {
        "start": "python -m http.server 8080",
        "lint": "eslint .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "format": "prettier --write \"js/**/*.js\" \"tests/**/*.js\" \"css/**/*.css\" index.html *.js *.json",
        "format:check": "prettier --check \"js/**/*.js\" \"tests/**/*.js\" \"css/**/*.css\" index.html *.js *.json"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "jsdom": "^31.0.1",
        "prettier": "^3.10.0",
        "vitest": "^5.1.0"
    }
}
